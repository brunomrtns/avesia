# =============================================================================
# Avesia — Worker Local (PRODUÇÃO)
# =============================================================================
# O start-worker-local.sh lê a senha do Redis e as credenciais do MinIO
# automaticamente do .env.prod. Você SÓ precisa configurar a API_KEY aqui.
#
# Setup (uma vez):
#   1. Gere uma API key na VPS:
#      TOKEN=$(curl -s http://localhost:3100/auth/login \
#        -H 'Content-Type: application/json' \
#        -d '{"email":"owner@demo.avesia","password":"SUA_SENHA"}' \
#        | python3 -c "import sys,json; print(json.load(sys.stdin)['tokens']['accessToken'])")
#      curl -s -X POST http://localhost:3100/api-keys \
#        -H "Authorization: Bearer $TOKEN" \
#        -H 'Content-Type: application/json' \
#        -d '{"name":"local-whisper-worker"}'
#      # Anote o campo "key" retornado
#
#   2. Copie este arquivo:
#      cp .env-worker-local.example .env-worker-local
#
#   3. Edite .env-worker-local e coloque a API key:
#      API_KEY=<cole-a-key-aqui>
#
#   4. Rode:
#      ./start-worker-local.sh
# =============================================================================

# Obrigatório: API key gerada na VPS
API_KEY=<cole-a-api-key-aqui>

# Opcional: overrides (o script auto-preenche do .env.prod se vazio)
# WHISPER_MODEL=medium
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=auto
# WHISPER_LANGUAGE=pt
# WHISPER_BEAM_SIZE=5
# WORKER_ID=local-worker-bruno-pc
