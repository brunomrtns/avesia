# =============================================================================
# AVESIA — .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.pnpm-store/

# --- Build outputs ---
dist/
build/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Environment ---
.env
.env.local
.env.prod
.env-worker-local
.env.*.local
!.env.example
!.env.*.example

# --- IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.logs/

# --- Docker ---
docker-compose.override.yml

# --- Local data volumes (never commit) ---
postgres-data/
redis-data/
minio-data/

# --- Test coverage ---
coverage/
.nyc_output/

# --- Temp / cache ---
tmp/
.temp/
.cache/
*.pid
*.seed
*.pid.lock

# --- Prisma ---
apps/api/prisma/migrations/dev.db*
apps/api/prisma/*.db-journal

# --- Typecheck cache ---
*.tsbuildinfo

# --- Storybook (if added later) ---
storybook-static/

# --- Misc ---
.dccache

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
celerybeat-schedule
celerybeat.pid

# --- Devin / AI agent local files ---
.devin/
.claude/

# --- Infrastructure docs (contain VPS IP, WireGuard config, etc) ---
DEPLOY.md

# --- Deploy/dev scripts (depend on my-vps, not part of the product code) ---
deploy.sh
dev.sh

avesia-secrets-backup-*.tar.gz.gpg
test-results/
playwright-report/
