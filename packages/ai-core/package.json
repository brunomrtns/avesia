{
  "name": "@avesia/ai-core",
  "version": "0.1.0",
  "private": true,
  "description": "Avesia AI Core — document intelligence pipeline, RAG retrieval, knowledge graph construction, and analysis. Provider-agnostic, decoupled from the application backend.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@avesia/ai-providers": "workspace:*",
    "@prisma/client": "^6.3.1",
    "ioredis": "^5.4.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@avesia/config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
