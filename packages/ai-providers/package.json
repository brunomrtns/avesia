  "private": true,
  "description": "AI provider abstraction layer for Avesia — OpenAI-compatible HTTP clients for OpenRouter, NVIDIA NIM, and Ollama",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
