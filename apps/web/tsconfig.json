{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@avesia/config/tsconfig.react.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src", "*.d.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
