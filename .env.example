# =============================================================================
# Avesia — Environment Variables
# =============================================================================
# Copy to .env and adjust values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env. All secrets below are PLACEHOLDERS.
# Generate strong secrets with:
#   openssl rand -base64 32
# =============================================================================

# --- App -----------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- API -----------------------------------------------------------------------
API_PORT=3100
API_HOST=0.0.0.0

# JWT secrets — MUST be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# --- Web -----------------------------------------------------------------------
WEB_PORT=3101
VITE_API_URL=/avesia/api
VITE_WS_URL=/avesia/ws

# --- Postgres ------------------------------------------------------------------
POSTGRES_PORT=5433
POSTGRES_DB=avesia
POSTGRES_USER=avesia
POSTGRES_PASSWORD=avesia_dev_password
# Used by Prisma and psql. In dev, localhost:5433 (host-exposed).
DATABASE_URL=postgresql://avesia:avesia_dev_password@localhost:5433/avesia?schema=public

# --- Redis ---------------------------------------------------------------------
REDIS_PORT=6380
# Used by BullMQ and pub/sub. In dev, localhost:6380 (host-exposed).
REDIS_URL=redis://localhost:6380

# --- MinIO / S3 ----------------------------------------------------------------
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=avesia_minio
MINIO_ROOT_PASSWORD=avesia_minio_dev_password
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=avesia
S3_ACCESS_KEY_ID=avesia_minio
S3_SECRET_ACCESS_KEY=avesia_minio_dev_password
S3_FORCE_PATH_STYLE=true

# --- AI Providers ---------------------------------------------------------------
# Active provider: openrouter | nvidia-nim | ollama
AI_PROVIDER=nvidia-nim

# OpenRouter (cloud)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# NVIDIA NIM (cloud)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=gemma3:12b

# Embedding model — must be available on the active provider.
#   ollama:      nomic-embed-text (768 dims)
#   nvidia-nim:  nvidia/llama-nemotron-embed-1b-v2 (2048 dims)
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2

# --- Local Worker ---------------------------------------------------------------
# Heartbeat-based local/cloud fallback (ADR-005)
LOCAL_WORKER_ENABLED=true
LOCAL_WORKER_HEARTBEAT_INTERVAL_MS=5000
LOCAL_WORKER_OFFLINE_THRESHOLD_MS=15000

# --- Python Worker --------------------------------------------------------------
# Port for the worker health check server
WORKER_PORT=3102
# Worker ID (auto-generated if empty)
WORKER_ID=
# Log level for the Python worker (debug, info, warning, error)
WORKER_LOG_LEVEL=info

# --- AI Core / Pipeline ---------------------------------------------------------
# Vector store backend: "in-memory" (brute-force cosine) | "pgvector" (ANN)
VECTOR_STORE=in-memory
# Embedding dimensions (must match the embedding model)
#   nomic-embed-text (Ollama)              = 768
#   nvidia/llama-nemotron-embed-1b-v2      = 2048
PGVECTOR_DIMENSIONS=2048
# Max chunks to run entity extraction on per document (cost control)
KB_MAX_EXTRACTION_CHUNKS=10
# Pipeline modes: "ner"/"textrank"/"tfidf" (deterministic, zero LLM) or "llm"
KB_ENTITY_MODE=ner
KB_SUMMARY_MODE=textrank
KB_CLASSIFY_MODE=tfidf

# --- CORS -----------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3101,http://localhost:5173

# --- Email (optional — graceful degradation if not configured) ------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Avesia <noreply@avesia.com>
