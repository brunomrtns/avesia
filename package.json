{
  "name": "avesia",
  "version": "0.1.17",
  "private": true,
  "description": "Avesia — Clinical AI support SaaS for psychologists",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @avesia/api db:generate",
    "db:migrate": "pnpm --filter @avesia/api db:migrate",
    "db:seed": "pnpm --filter @avesia/api db:seed",
    "db:studio": "pnpm --filter @avesia/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
